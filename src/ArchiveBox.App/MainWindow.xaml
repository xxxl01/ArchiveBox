<Window x:Class="ArchiveBox.App.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="clr-namespace:ArchiveBox.App"
 Title="归档盒 · ArchiveBox" Width="1440" Height="880" MinWidth="1180" MinHeight="720"
 WindowStartupLocation="CenterScreen" Loaded="Window_Loaded" Closing="Window_Closing">
 <Window.InputBindings>
  <KeyBinding Key="F5" Command="{Binding RefreshCommand}" />
  <KeyBinding Key="O" Modifiers="Control" Command="{Binding ChooseSourceCommand}" />
 </Window.InputBindings>
 <Grid>
  <Grid.ColumnDefinitions><ColumnDefinition Width="196" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
  <Border Grid.Column="0" Background="#EAF0EC" BorderBrush="#DCE5DE" BorderThickness="0,0,1,0">
   <Grid Margin="16,28,16,20">
    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
    <StackPanel Margin="12,0,0,32">
     <StackPanel Orientation="Horizontal">
      <Border Background="#147D64" CornerRadius="10" Width="35" Height="35" Margin="0,0,10,0">
       <TextBlock Text="&#xE7B8;" FontFamily="Segoe MDL2 Assets" Foreground="White" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" />
      </Border>
      <TextBlock Text="归档盒" FontSize="24" FontWeight="SemiBold" VerticalAlignment="Center" />
     </StackPanel>
     <TextBlock Text="给文件一个好去处" Foreground="#718177" Margin="0,12,0,0" FontSize="12" />
    </StackPanel>
    <StackPanel Grid.Row="1">
     <TextBlock Text="工作空间" Foreground="#7C8C82" FontSize="11" Margin="14,0,0,12" />
     <Button Command="{Binding SwitchViewCommand}" CommandParameter="browse">
      <Button.Style><Style TargetType="Button" BasedOn="{StaticResource NavButton}"><Style.Triggers>
       <DataTrigger Binding="{Binding CurrentView}" Value="browse"><Setter Property="Background" Value="#D3E6DA" /><Setter Property="FontWeight" Value="SemiBold" /></DataTrigger>
      </Style.Triggers></Style></Button.Style>
      <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets" Margin="0,0,12,0" /><TextBlock Text="浏览文件" /></StackPanel>
     </Button>
     <Button Command="{Binding SwitchViewCommand}" CommandParameter="all">
      <Button.Style><Style TargetType="Button" BasedOn="{StaticResource NavButton}"><Style.Triggers>
       <DataTrigger Binding="{Binding CurrentView}" Value="all"><Setter Property="Background" Value="#D3E6DA" /><Setter Property="FontWeight" Value="SemiBold" /></DataTrigger>
      </Style.Triggers></Style></Button.Style>
      <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE7B8;" FontFamily="Segoe MDL2 Assets" Margin="0,0,12,0" /><TextBlock Text="全部归档" /><TextBlock Text="{Binding ArchiveCount}" Margin="12,0,0,0" Foreground="#718177" /></StackPanel>
     </Button>
     <Button Command="{Binding SwitchViewCommand}" CommandParameter="soon">
      <Button.Style><Style TargetType="Button" BasedOn="{StaticResource NavButton}"><Style.Triggers>
       <DataTrigger Binding="{Binding CurrentView}" Value="soon"><Setter Property="Background" Value="#D3E6DA" /><Setter Property="FontWeight" Value="SemiBold" /></DataTrigger>
      </Style.Triggers></Style></Button.Style>
      <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE823;" FontFamily="Segoe MDL2 Assets" Margin="0,0,12,0" /><TextBlock Text="即将到期" /><TextBlock Text="{Binding SoonCount}" Margin="12,0,0,0" Foreground="#718177" /></StackPanel>
     </Button>
     <Button Command="{Binding SwitchViewCommand}" CommandParameter="due">
      <Button.Style><Style TargetType="Button" BasedOn="{StaticResource NavButton}"><Style.Triggers>
       <DataTrigger Binding="{Binding CurrentView}" Value="due"><Setter Property="Background" Value="#D3E6DA" /><Setter Property="FontWeight" Value="SemiBold" /></DataTrigger>
      </Style.Triggers></Style></Button.Style>
      <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE916;" FontFamily="Segoe MDL2 Assets" Margin="0,0,12,0" /><TextBlock Text="已到期" /><TextBlock Text="{Binding DueCount}" Margin="12,0,0,0" Foreground="#A65F36" /></StackPanel>
     </Button>
     <Border Height="1" Background="#D5DFD8" Margin="12,15" />
     <Button Command="{Binding SwitchViewCommand}" CommandParameter="history">
      <Button.Style><Style TargetType="Button" BasedOn="{StaticResource NavButton}"><Style.Triggers>
       <DataTrigger Binding="{Binding CurrentView}" Value="history"><Setter Property="Background" Value="#D3E6DA" /><Setter Property="FontWeight" Value="SemiBold" /></DataTrigger>
      </Style.Triggers></Style></Button.Style>
      <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE81C;" FontFamily="Segoe MDL2 Assets" Margin="0,0,12,0" /><TextBlock Text="任务记录" /></StackPanel>
     </Button>
    </StackPanel>
    <StackPanel Grid.Row="2" Margin="10,0,0,0">
     <Button Content="打开本地数据目录" Command="{Binding OpenDataCommand}" Padding="0,8" HorizontalAlignment="Left" Background="Transparent" BorderThickness="0" Foreground="#64796D" FontSize="11" />
     <TextBlock Text="ArchiveBox  /  v0.1.0" FontSize="11" Foreground="#8A988E" Margin="0,9,0,0" />
    </StackPanel>
   </Grid>
  </Border>

  <Grid Grid.Column="1" Margin="26,26,26,16">
   <Grid.RowDefinitions>
    <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" />
   </Grid.RowDefinitions>
   <Grid Margin="0,0,0,22">
    <StackPanel>
     <TextBlock Text="{Binding PageTitle}" FontSize="26" FontWeight="SemiBold" />
     <TextBlock Text="{Binding PageSubtitle}" Foreground="#7B8980" Margin="0,8,0,0" />
    </StackPanel>
    <Border HorizontalAlignment="Right" VerticalAlignment="Top" Background="#E5EFE8" CornerRadius="12" Padding="12,6">
     <TextBlock Text="●  本地文件 · 本地存储" Foreground="#52775D" FontSize="11" />
    </Border>
   </Grid>

   <Grid Grid.Row="1" Margin="0,0,0,16">
    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
    <Grid Visibility="{Binding IsBrowser, Converter={StaticResource BoolVisibility}}" Margin="0,0,0,12" IsEnabled="{Binding IsIdle}">
     <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
     <Button Content="↑" Command="{Binding UpCommand}" ToolTip="上一级目录" Padding="13,6" />
     <ComboBox x:Name="FolderBox" Grid.Column="1" ItemsSource="{Binding RecentFolders}" IsEditable="True"
       Text="{Binding CurrentFolder, UpdateSourceTrigger=PropertyChanged}" KeyDown="FolderBox_KeyDown"
       SelectionChanged="FolderBox_SelectionChanged" ToolTip="输入路径后按 Enter，或选择最近打开的目录" Margin="0,0,10,0" />
     <Button Grid.Column="2" Content="打开" Command="{Binding NavigateCommand}" CommandParameter="{Binding CurrentFolder}" />
     <Button Grid.Column="3" Content="选择文件夹" Command="{Binding ChooseSourceCommand}" Margin="0" />
    </Grid>
    <Grid Grid.Row="1">
     <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
     <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsIdle}" ToolTip="搜索当前列表中的文件名或路径" MaxWidth="420" HorizontalAlignment="Left" MinWidth="240" />
     <TextBlock Text="搜索当前列表" Foreground="#8E9B93" IsHitTestVisible="False" VerticalAlignment="Center" Margin="12,0,0,0">
      <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers>
       <DataTrigger Binding="{Binding SearchText}" Value=""><Setter Property="Visibility" Value="Visible" /></DataTrigger>
      </Style.Triggers></Style></TextBlock.Style>
     </TextBlock>
     <Button Grid.Column="1" Content="全选 / 取消" Command="{Binding SelectAllCommand}" />
     <Button Grid.Column="2" Content="刷新  F5" Command="{Binding RefreshCommand}" Margin="0" />
    </Grid>
   </Grid>

   <Grid Grid.Row="2">
    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="20" /><ColumnDefinition Width="296" /></Grid.ColumnDefinitions>
    <Border Background="White" BorderBrush="#E0E7E2" BorderThickness="1" CornerRadius="10" ClipToBounds="True">
     <Grid>
      <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
      <DataGrid x:Name="FilesGrid" ItemsSource="{Binding FilesView}" SelectedItem="{Binding FocusedRow}"
          MouseDoubleClick="FilesGrid_MouseDoubleClick" SelectionChanged="FilesGrid_SelectionChanged" IsEnabled="{Binding IsIdle}">
       <DataGrid.Columns>
        <DataGridTemplateColumn Width="38" CanUserSort="False">
         <DataGridTemplateColumn.CellTemplate><DataTemplate>
          <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center" Focusable="False" Click="RowCheckBox_Click" />
         </DataTemplate></DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
        <DataGridTemplateColumn Header="文件名" Width="*" MinWidth="170" SortMemberPath="Name">
         <DataGridTemplateColumn.CellTemplate><DataTemplate>
          <StackPanel Orientation="Horizontal">
           <TextBlock Text="{Binding Icon}" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="#49806A" Margin="0,0,10,0" VerticalAlignment="Center" />
           <TextBlock Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
          </StackPanel>
         </DataTemplate></DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
        <DataGridTextColumn Header="大小" Binding="{Binding SizeText}" SortMemberPath="Size" Width="86" />
        <DataGridTextColumn Header="修改 / 归档时间" Binding="{Binding ModifiedText}" SortMemberPath="ModifiedAt" Width="145" />
        <DataGridTextColumn Header="预计删除" Binding="{Binding ExpiryText}" SortMemberPath="Item.ExpiresAt" Width="106" />
        <DataGridTextColumn Header="状态" Binding="{Binding StatusText}" Width="114" />
       </DataGrid.Columns>
      </DataGrid>
      <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
       <StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers>
        <DataTrigger Binding="{Binding FileCount}" Value="0"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
       </Style.Triggers></Style></StackPanel.Style>
       <TextBlock Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets" FontSize="34" Foreground="#A4BAAC" HorizontalAlignment="Center" />
       <TextBlock Text="这里暂时没有文件" Foreground="#7E9084" Margin="0,16,0,0" HorizontalAlignment="Center" />
       <TextBlock Text="选择文件夹，或调整搜索条件" Foreground="#A0ADA4" Margin="0,7,0,0" FontSize="11" />
      </StackPanel>
      <Border Grid.Row="1" BorderBrush="#EDF1EE" BorderThickness="0,1,0,0" Padding="14,10">
       <Grid>
        <TextBlock Text="{Binding SelectionText}" Foreground="#7E8D82" FontSize="11" />
        <TextBlock Text="支持多选 · Ctrl / Shift" HorizontalAlignment="Right" Foreground="#A1ADA5" FontSize="11" />
       </Grid>
      </Border>
     </Grid>
    </Border>

    <Border Grid.Column="2" Background="White" BorderBrush="#E0E7E2" BorderThickness="1" CornerRadius="10" Padding="18">
     <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel>
       <Grid Margin="0,0,0,14">
        <TextBlock Text="归档位置" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
        <Button Content="选择根目录" Command="{Binding ChooseRootCommand}" HorizontalAlignment="Right" FontSize="11" Padding="8,5" Margin="0" />
       </Grid>
       <Border Background="#F5F8F6" CornerRadius="6" Padding="8" MinHeight="110" MaxHeight="225">
        <TreeView ItemsSource="{Binding TargetTree}" SelectedItemChanged="TargetTree_SelectedItemChanged" Background="Transparent" BorderThickness="0" IsEnabled="{Binding IsIdle}">
         <TreeView.ItemTemplate><HierarchicalDataTemplate DataType="{x:Type local:FolderNode}" ItemsSource="{Binding Children}">
          <StackPanel Orientation="Horizontal" Margin="0,5"><TextBlock Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets" Foreground="#49806A" Margin="0,0,7,0" /><TextBlock Text="{Binding Name}" ToolTip="{Binding Path}" /></StackPanel>
         </HierarchicalDataTemplate></TreeView.ItemTemplate>
         <TreeView.ItemContainerStyle><Style TargetType="TreeViewItem">
          <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" /><Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
          <EventSetter Event="Expanded" Handler="FolderNode_Expanded" />
         </Style></TreeView.ItemContainerStyle>
        </TreeView>
       </Border>
       <TextBlock Text="{Binding TargetDisplay}" TextWrapping="Wrap" Foreground="#7E8D82" FontSize="11" Margin="0,10,0,12" />
       <Grid IsEnabled="{Binding IsIdle}">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
        <TextBox Text="{Binding NewFolderName, UpdateSourceTrigger=PropertyChanged}" ToolTip="子目录名称，支持 工作/项目 A" FontSize="11" Padding="7,7" />
        <Button Grid.Column="1" Content="新建" Command="{Binding CreateFolderCommand}" Padding="8,7" Margin="6,0,0,0" FontSize="11" />
       </Grid>
       <Button Content="刷新目录树" Command="{Binding RefreshTreeCommand}" Padding="0,7" HorizontalAlignment="Left" Foreground="#7D8F81" Background="Transparent" BorderThickness="0" FontSize="11" />
       <Border Height="1" Background="#EDF1EE" Margin="0,6,0,15" />

       <StackPanel Visibility="{Binding IsBrowser, Converter={StaticResource BoolVisibility}}">
        <TextBlock Text="归档方式" FontWeight="SemiBold" Margin="0,0,0,8" />
        <ComboBox ItemsSource="{Binding Modes}" SelectedIndex="{Binding SelectedMode}" IsEnabled="{Binding IsIdle}" />
        <TextBlock Text="{Binding ModeHint}" FontSize="11" Foreground="#829087" TextWrapping="Wrap" Margin="0,8,0,14" />
       </StackPanel>
       <TextBlock Text="预计删除时间" FontWeight="SemiBold" Margin="0,0,0,8" />
       <ComboBox ItemsSource="{Binding Retentions}" SelectedIndex="{Binding SelectedRetention}" IsEnabled="{Binding IsIdle}" />
       <DatePicker SelectedDate="{Binding CustomDate}" Visibility="{Binding ShowCustomDate, Converter={StaticResource BoolVisibility}}" Margin="0,8,0,0" IsEnabled="{Binding IsIdle}" />
       <TextBlock Text="仅用于归档文件；到期后手动确认回收。" FontSize="11" Foreground="#829087" TextWrapping="Wrap" Margin="0,8,0,14" />
       <TextBlock Text="遇到同名文件" FontWeight="SemiBold" Margin="0,0,0,8" />
       <ComboBox ItemsSource="{Binding Conflicts}" SelectedIndex="{Binding SelectedConflict}" IsEnabled="{Binding IsIdle}" Margin="0,0,0,16" />

       <Button Content="开始归档" Command="{Binding ArchiveCommand}" Style="{StaticResource PrimaryButton}" Padding="12,11" Margin="0,0,0,8" Visibility="{Binding IsBrowser, Converter={StaticResource BoolVisibility}}" />
       <StackPanel>
        <StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Visible" /><Style.Triggers>
         <DataTrigger Binding="{Binding IsBrowser}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
        </Style.Triggers></Style></StackPanel.Style>
        <Button Content="应用预计删除时间" Command="{Binding UpdateExpiryCommand}" Style="{StaticResource PrimaryButton}" Margin="0,0,0,8" />
        <Button Content="移入回收站" Command="{Binding RecycleCommand}" Foreground="#A45D40" Margin="0,0,0,8" />
        <Button Content="重试所选失败任务" Command="{Binding RetryCommand}" Margin="0,0,0,8" Visibility="{Binding IsHistory, Converter={StaticResource BoolVisibility}}" />
       </StackPanel>
       <Border Height="1" Background="#EDF1EE" Margin="0,12,0,14" />
       <TextBlock Text="{Binding DetailName}" FontWeight="SemiBold" TextWrapping="Wrap" />
       <TextBlock Text="{Binding DetailPath}" TextWrapping="Wrap" FontSize="11" Foreground="#829087" Margin="0,7,0,0" />
       <TextBlock Text="{Binding DetailSource}" TextWrapping="Wrap" FontSize="11" Foreground="#829087" Margin="0,6,0,0" />
       <TextBlock Text="{Binding DetailExpiry}" TextWrapping="Wrap" FontSize="11" Foreground="#829087" Margin="0,6,0,0" />
       <TextBlock Text="{Binding DetailError}" TextWrapping="Wrap" FontSize="11" Foreground="#A45D40" Margin="0,6,0,0" />
       <Button Content="在资源管理器中显示" Command="{Binding RevealCommand}" FontSize="11" Padding="8,6" Margin="0,12,0,0" />
      </StackPanel>
     </ScrollViewer>
    </Border>
   </Grid>

   <StackPanel Grid.Row="3" Margin="0,14,0,0">
    <Grid Margin="0,0,0,7" Visibility="{Binding IsBusy, Converter={StaticResource BoolVisibility}}">
     <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
     <StackPanel VerticalAlignment="Center">
      <TextBlock Text="{Binding ProgressText}" FontSize="11" Foreground="#658373" TextTrimming="CharacterEllipsis" Margin="0,0,0,5" />
      <ProgressBar Value="{Binding Progress}" Maximum="100" Height="4" BorderThickness="0" Foreground="#147D64" Background="#E0EAE3" />
     </StackPanel>
     <Button Grid.Column="1" Content="取消" Command="{Binding CancelCommand}" Margin="14,0,0,0" Padding="12,6" />
    </Grid>
    <TextBlock Text="{Binding Status}" FontSize="11" Foreground="#6D8174" TextTrimming="CharacterEllipsis" ToolTip="{Binding Status}" />
    <Expander Header="最近操作详情" FontSize="11" Foreground="#85978A" Margin="0,8,0,0">
     <TextBox Text="{Binding ResultDetails, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" MaxHeight="90" MinHeight="35" Background="Transparent" BorderThickness="0" />
    </Expander>
   </StackPanel>
  </Grid>
 </Grid>
</Window>
